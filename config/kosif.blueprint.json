  "risk_engine":{"bands":[{"id":"low","label_ar":"منخفضة","from":0,"to":39},{"id":"moderate","label_ar":"متوسطة","from":40,"to":64},{"id":"high","label_ar":"مرتفعة","from":65,"to":84},{"id":"significant","label_ar":"جوهرية","from":85,"to":100}]},
  "deterministic_checks":{"trial_balance":[{"id":"TB-01","label_ar":"عدم توازن إجمالي المدين والدائن","severity":"critical"},{"id":"TB-02","label_ar":"أرقام حسابات مكررة","severity":"critical"},{"id":"TB-03","label_ar":"رصيد غير طبيعي مقابل طبيعة الحساب","severity":"high"},{"id":"TB-07","label_ar":"تغير جوهري عن السنة السابقة","severity":"high"},{"id":"TB-09","label_ar":"حسابات معلقة برصيد قائم","severity":"high"}]},
  "opinion_engine":{"decision_tree":{"root":"q_source","nodes":{"q_source":{"question_ar":"هل يوجد تحريف جوهري أو تعذر الحصول على أدلة كافية؟","options":[{"value":"material_misstatement","next":"q_ms_pervasive"},{"value":"inability_to_obtain_evidence","next":"q_ev_pervasive"},{"value":"none","next":"q_going_concern"}]},"q_ms_pervasive":{"question_ar":"هل التحريف الجوهري منتشر؟","yes":"res_adverse","no":"res_qualified_ms"},"q_ev_pervasive":{"question_ar":"هل آثار تعذر الحصول على الأدلة قد تكون جوهرية ومنتشرة؟","yes":"res_disclaimer","no":"res_qualified_ev"},"q_going_concern":{"question_ar":"ما حالة عدم التأكد المتعلق بالاستمرارية؟","options":[{"value":"uncertainty_exists_and_adequately_disclosed","next":"res_unmodified_gc"},{"value":"no_uncertainty","next":"q_other_matters"}]},"q_other_matters":{"question_ar":"هل توجد مسألة أخرى تعدل الرأي؟","yes":"res_qualified_ms","no":"res_unmodified"}},"results":{"res_qualified_ms":{"opinion":"qualified","label_ar":"رأي متحفظ","isa_ref":"ISA_705.7"},"res_adverse":{"opinion":"adverse","label_ar":"رأي معاكس","isa_ref":"ISA_705.8"},"res_qualified_ev":{"opinion":"qualified","label_ar":"رأي متحفظ لقصور الأدلة","isa_ref":"ISA_705.7"},"res_disclaimer":{"opinion":"disclaimer","label_ar":"امتناع عن إبداء الرأي","isa_ref":"ISA_705.9"},"res_unmodified_gc":{"opinion":"unmodified","label_ar":"غير معدل مع فقرة عدم تأكد جوهري متعلق بالاستمرارية","isa_ref":"ISA_570.22"},"res_unmodified":{"opinion":"unmodified","label_ar":"رأي غير معدل","isa_ref":"ISA_700"}}}},
  "ai_layer":{"tasks":[{"id":"T.FINDING_NARRATIVE","schema_id":"finding_narrative_v1","temperature":0.2},{"id":"T.ADVISOR","schema_id":"advisor_v1","temperature":0.2},{"id":"T.COUNCIL","schema_id":"council_v2","temperature":0.1}]},
