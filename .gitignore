# Dependencies — wrangler is a devDependency, so `npm install` is required to run the
# checks or `wrangler dev`. Without this file a broad `git add -A` after a local run
# would commit the whole tree.
node_modules/
package-lock.json

# Wrangler local state (Miniflare KV, caches, build output)
.wrangler/
.dev.vars
.dev.vars.*

# Playwright browser QA artefacts
playwright-report/
test-results/

# Design quality / Storybook / Lighthouse artefacts
storybook-static/
.lighthouseci/

# Motion workspaces
motion/remotion/out/
motion/hyperframes/renders/

# Gemini CLI local/runtime state
.gemini/
gha-creds-*.json

# Runtime-verifier artefacts
kosif-v36-3-mobile.png
*.local.png

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Generated source export — CI artifact only; repository tree remains source of truth
Kosif-Full-Application-Source.json
