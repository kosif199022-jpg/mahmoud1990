{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kosif-engineering-copilot-mcp",
  "main": "src/oauth.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "KOSIF_REPO_OWNER": "kosif199022-jpg",
    "KOSIF_REPO_NAME": "mahmoud1990",
    "KOSIF_LIVE_URL": "https://mahmoud-eldesouky.kosif199022.workers.dev"
  }
}
