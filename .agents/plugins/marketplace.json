{
  "name": "kosif-local-plugins",
  "version": "2.1.0",
  "description": "KOSIF governed plugin registry for the OAuth-protected engineering MCP server, server-side AI orchestration, and approved in-app developer tools.",
  "interface": {
    "displayName": "KOSIF Local Plugins"
  },
  "orchestratorConfig": "../configs/gemini-orchestrator.json",
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": true
  },
  "plugins": [
    {
      "name": "kosif-engineering-copilot",
      "source": {
        "source": "local",
        "path": "./plugins/kosif-engineering-copilot"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "chatgpt-responsive-preview",
      "source": {
        "source": "local",
        "path": "./plugins/chatgpt-responsive-preview"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "NONE"
      },
      "category": "Developer Tools",
      "entrypoint": "/preview/index.html"
    }
  ]
}
