    "reviewer-media": "node scripts/check-reviewer-media-v36-3.mjs",
    "history-restoration": "node scripts/check-history-restoration-v36-3.mjs",
    "feature-reachability": "node scripts/check-feature-reachability-v36-3.mjs",
    "accounting": "node scripts/check-accounting-v36.mjs",
    "v37-engine": "node tests/kosif.engine.test.mjs",
    "v37-root": "node scripts/check-v37-root-rebuild.mjs",
    "libraries-sales": "node scripts/check-kosif-libraries-sales-v1.mjs",
    "v38-core": "node tests/v38-core.test.mjs",
    "v38-graph": "node tests/v38-evidence-graph.test.mjs",
    "v38-sources": "node tests/v38-source-intelligence.test.mjs",
