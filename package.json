    "product-polish-phase-d": "node scripts/check-product-polish-phase-d.mjs",
    "legacy-contract": "node scripts/check-v36-3-contract.mjs",
    "history-parity": "node scripts/check-history-parity-v36-3.mjs",
    "security-edge": "node scripts/check-security-edge-v36-3.mjs",
