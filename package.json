    "motion:hyperframes:inspect": "npm --prefix motion/hyperframes run inspect",
    "motion:hyperframes:preview": "npm --prefix motion/hyperframes run preview",
    "motion:hyperframes:render": "npm --prefix motion/hyperframes run render"
