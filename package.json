    "payloads": "node scripts/validate-payloads.mjs",
    "source-export-integrity": "node scripts/check-source-export-integrity.mjs",
    "legacy-regressions": "node scripts/check-legacy-regressions.mjs",
    "audit": "node scripts/deep-audit-v36.mjs",
    "contract": "node scripts/check-v36-4-contract.mjs",
