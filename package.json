    "v38-sales-audit": "node tests/v38-sales-audit-bridge.test.mjs",
    "v38-suite": "npm run v38-core && npm run v38-graph && npm run v38-sources && npm run v38-api && npm run v38-public-ai && npm run v38-realtime && npm run v38-sales-audit && node scripts/check-v38.mjs",
    "book-engine": "node tests/book-engine-v1.test.mjs",
    "v40-experience": "node scripts/check-v40-experience.mjs",
    "v41-experience": "node scripts/check-v41-experience.mjs",
